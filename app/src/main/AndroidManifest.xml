<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Izin Akses Internet untuk Glide & API -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/logo_edunusa"
        android:label="@string/app_name"
        android:roundIcon="@drawable/logo_edunusa"
        android:supportsRtl="true"
        android:theme="@style/Theme.Edunusa">

        <!-- 1. SplashScreenActivity sebagai Main Launcher -->
        <activity
            android:name=".SplashScreenActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. LoginActivity -->
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 3. BaseActivity (Container 4 Fragment Utama) -->
        <activity
            android:name=".BaseActivity"
            android:exported="false" />

        <!-- 4. DetailMateriActivity -->
        <activity
            android:name=".DetailMateriActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 5. KuisActivity -->
        <activity
            android:name=".KuisActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>
