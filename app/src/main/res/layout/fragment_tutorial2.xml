<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tutorial_green"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <!-- Card Ilustrasi Kuis -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="160dp"
        android:layout_height="160dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="80dp"
        app:cardElevation="4dp"
        app:strokeColor="@color/success_green_light"
        app:strokeWidth="4dp">

        <ImageView
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_gravity="center"
            android:contentDescription="Ilustrasi Kuis"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_calculate"
            app:tint="@color/success_green" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:background="@drawable/bg_badge_green"
        android:fontFamily="sans-serif-medium"
        android:paddingHorizontal="14dp"
        android:paddingVertical="4dp"
        android:text="Kuis Interaktif"
        android:textColor="@color/success_green"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvTutorialTitle2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-black"
        android:gravity="center"
        android:text="Uji Kemampuanmu"
        android:textColor="@color/primary_navy"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvTutorialDesc2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="Kerjakan kuis interaktif berbatas waktu dan raih poin belajar untuk setiap jawaban benar."
        android:textColor="@color/text_secondary"
        android:textSize="15sp" />

</LinearLayout>
