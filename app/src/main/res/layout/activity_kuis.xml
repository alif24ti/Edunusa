<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootKuis"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:elevation="2dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/white"
            app:popupTheme="@style/ThemeOverlay.Material3.Light"
            app:title="Kuis Pecahan"
            app:titleTextColor="@color/primary_navy" />
    </com.google.android.material.appbar.AppBarLayout>


    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="96dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="18dp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvQuestionProgress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-bold"
                    android:text="Pertanyaan 3 dari 10 (30%)"
                    android:textColor="@color/primary_navy"
                    android:textSize="14sp" />


                <LinearLayout
                    android:id="@+id/layoutTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_timer_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="Timer"
                        android:src="@drawable/ic_timer"
                        app:tint="@color/brand_blue" />

                    <TextView
                        android:id="@+id/tvTimer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="08:30"
                        android:textColor="@color/brand_blue"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>


            <ProgressBar
                android:id="@+id/pbQuizProgress"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="10dp"
                android:max="10"
                android:progress="3"
                android:progressDrawable="@drawable/pb_rounded_brand" />


            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardQuestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvQuestionBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_pill"
                        android:fontFamily="sans-serif-bold"
                        android:text="Matematika Dasar • Pecahan"
                        android:textColor="@color/brand_blue"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvQuestionText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="sans-serif-black"
                        android:lineSpacingExtra="3dp"
                        android:text="Berapakah hasil dari 1/2 + 1/4?"
                        android:textColor="@color/primary_navy"
                        android:textSize="19sp"
                        android:textStyle="bold" />


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_rounded_card_light"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="½  +  ¼  =  2/4  +  1/4  =  ?"
                            android:textColor="@color/brand_blue"
                            android:textSize="18sp"
                            android:textStyle="bold" />


                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:background="@drawable/bg_icon_squircle_blue"
                                android:fontFamily="sans-serif-bold"
                                android:gravity="center"
                                android:text="½"
                                android:textColor="@color/brand_blue"
                                android:textSize="15sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="10dp"
                                android:fontFamily="sans-serif-bold"
                                android:text="+"
                                android:textColor="@color/primary_navy"
                                android:textSize="16sp" />

                            <TextView
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:background="@drawable/bg_icon_squircle_blue"
                                android:fontFamily="sans-serif-bold"
                                android:gravity="center"
                                android:text="¼"
                                android:textColor="@color/brand_blue"
                                android:textSize="15sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="10dp"
                                android:fontFamily="sans-serif-bold"
                                android:text="="
                                android:textColor="@color/primary_navy"
                                android:textSize="16sp" />

                            <TextView
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:background="@drawable/bg_icon_squircle_green"
                                android:fontFamily="sans-serif-bold"
                                android:gravity="center"
                                android:text="?"
                                android:textColor="@color/success_green"
                                android:textSize="16sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="sans-serif"
                            android:text="Petunjuk: Samakan penyebut 2 menjadi 4"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif-bold"
                android:text="Pilihan Jawaban:"
                android:textColor="@color/primary_navy"
                android:textSize="15sp" />


            <LinearLayout
                android:id="@+id/optionA"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_quiz_option_unselected"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <TextView
                    android:id="@+id/tvLabelA"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_icon_squircle_blue"
                    android:fontFamily="sans-serif-bold"
                    android:gravity="center"
                    android:text="A"
                    android:textColor="@color/brand_blue"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvOptionTextA"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-bold"
                    android:text="1 / 4"
                    android:textColor="@color/primary_navy"
                    android:textSize="16sp" />

                <ImageView
                    android:id="@+id/ivCheckA"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Status"
                    android:src="@drawable/ic_check_circle"
                    android:visibility="gone" />
            </LinearLayout>


            <LinearLayout
                android:id="@+id/optionB"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_quiz_option_unselected"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <TextView
                    android:id="@+id/tvLabelB"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_icon_squircle_blue"
                    android:fontFamily="sans-serif-bold"
                    android:gravity="center"
                    android:text="B"
                    android:textColor="@color/brand_blue"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvOptionTextB"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-bold"
                    android:text="2 / 4"
                    android:textColor="@color/primary_navy"
                    android:textSize="16sp" />

                <ImageView
                    android:id="@+id/ivCheckB"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Status"
                    android:src="@drawable/ic_check_circle"
                    android:visibility="gone" />
            </LinearLayout>


            <LinearLayout
                android:id="@+id/optionC"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_quiz_option_selected"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <TextView
                    android:id="@+id/tvLabelC"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_button_brand"
                    android:fontFamily="sans-serif-bold"
                    android:gravity="center"
                    android:text="C"
                    android:textColor="@color/white"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvOptionTextC"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-bold"
                    android:text="3 / 4"
                    android:textColor="@color/brand_blue"
                    android:textSize="16sp" />

                <ImageView
                    android:id="@+id/ivCheckC"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Status"
                    android:src="@drawable/ic_check_circle"
                    android:visibility="visible" />
            </LinearLayout>


            <LinearLayout
                android:id="@+id/optionD"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_quiz_option_unselected"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <TextView
                    android:id="@+id/tvLabelD"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_icon_squircle_blue"
                    android:fontFamily="sans-serif-bold"
                    android:gravity="center"
                    android:text="D"
                    android:textColor="@color/brand_blue"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvOptionTextD"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-bold"
                    android:text="4 / 4"
                    android:textColor="@color/primary_navy"
                    android:textSize="16sp" />

                <ImageView
                    android:id="@+id/ivCheckD"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Status"
                    android:src="@drawable/ic_check_circle"
                    android:visibility="gone" />
            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_badge_yellow"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Tips"
                    android:src="@drawable/ic_lightbulb" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif"
                    android:text="Tips Pintar: Samakan penyebut terlebih dahulu sebelum menjumlahkan pembilang: 1/2 = 2/4, jadi 2/4 + 1/4 = 3/4."
                    android:textColor="@color/warning_orange"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>


    <LinearLayout
        android:id="@+id/layoutBottomQuiz"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/white"
        android:elevation="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="14dp">


        <ImageView
            android:id="@+id/btnBookmark"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_rounded_card"
            android:clickable="true"
            android:contentDescription="Simpan Soal"
            android:focusable="true"
            android:padding="12dp"
            android:src="@drawable/ic_bookmark" />


        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNextQuestion"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:backgroundTint="@color/brand_blue"
            android:fontFamily="sans-serif-bold"
            android:text="Lanjut  →"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp"
            app:cornerRadius="26dp"
            app:elevation="3dp" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
