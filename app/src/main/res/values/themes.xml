<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Edunusa" parent="Theme.Material3.Light.NoActionBar">
        <!-- Brand Colors -->
        <item name="colorPrimary">@color/brand_blue</item>
        <item name="colorPrimaryVariant">@color/brand_blue_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/primary_navy</item>
        <item name="colorOnSecondary">@color/white</item>
        
        <!-- Backgrounds and Surfaces -->
        <item name="android:windowBackground">@color/bg_screen</item>
        <item name="android:statusBarColor">@color/bg_screen</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.Edunusa" parent="Base.Theme.Edunusa" />

    <!-- Style for Toolbar -->
    <style name="EduNusaToolbarTheme" parent="ThemeOverlay.Material3.ActionBar">
        <item name="android:textColorPrimary">@color/primary_navy</item>
        <item name="actionMenuTextColor">@color/primary_navy</item>
    </style>
</resources>