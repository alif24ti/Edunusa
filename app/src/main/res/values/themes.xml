<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.Edunusa" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_blue</item>
        <item name="colorPrimaryVariant">@color/brand_blue_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/primary_navy</item>
        <item name="colorOnSecondary">@color/white</item>
        

        <item name="android:windowBackground">@color/bg_screen</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.Edunusa" parent="Base.Theme.Edunusa" />


    <style name="EduNusaToolbarTheme" parent="ThemeOverlay.Material3.ActionBar">
        <item name="android:textColorPrimary">@color/primary_navy</item>
        <item name="actionMenuTextColor">@color/primary_navy</item>
    </style>


    <style name="EduNusa.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="itemActiveIndicatorStyle">@style/EduNusa.BottomNav.ActiveIndicator</item>
        <item name="itemIconTint">@color/nav_item_color</item>
        <item name="itemTextColor">@color/nav_item_color</item>
        <item name="itemIconSize">22dp</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="android:background">@color/white</item>
    </style>

    <style name="EduNusa.BottomNav.ActiveIndicator">
        <item name="android:color">@color/light_surface</item>
    </style>


    <style name="ShapeAppearance.RoundedLogo" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ShapeAppearance.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>